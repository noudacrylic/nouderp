# ============================================================
# Template .env untuk SERVER PRODUKSI (Ubuntu on-premise)
# Salin ke .env di server lalu isi nilai aslinya:
#   cp .env.production.example .env  &&  php artisan key:generate
# JANGAN commit file .env asli (sudah di-gitignore).
# ============================================================

APP_NAME="Noud ERP"
APP_ENV=production
APP_KEY=                              # diisi otomatis oleh: php artisan key:generate
APP_DEBUG=false                       # WAJIB false di produksi
APP_URL=https://erp.domainanda.com    # dipakai untuk callback webhook & link Midtrans
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# --- Database (buat dulu di server: lihat deploy/README.md) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=noud_erp
DB_USERNAME=noud
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

# --- Session / cache / queue (tanpa worker; queue=sync) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Log ---
LOG_CHANNEL=stack
LOG_LEVEL=error                       # produksi: error saja (kurangi noise)

# --- Browsershot / PDF (jika Chromium tidak terdeteksi otomatis) ---
# Isi bila cetak PDF gagal di server (lihat deploy/README.md, bagian PDF):
# BROWSERSHOT_NODE_BINARY=/usr/bin/node
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium-browser

# --- Integrasi (diisi setelah kredensial tersedia) ---
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
# Biteship
BITESHIP_API_KEY=
# Jubelio: kredensial diatur lewat UI (Settings -> Integrasi -> Jubelio), bukan di sini.
